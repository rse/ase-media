Output               {{ name }}.mp4

Require              ase
Require              claude

Set FontSize         {{ font_size }}
Set Width            1200
Set Height           1400

Set Shell            bash

Set FontFamily       "Menlo"
Set LineHeight       1.00
Set BorderRadius     0
Set Padding          10

Set Framerate        60
Set TypingSpeed      0.10
Set PlaybackSpeed    0.50

Set WaitTimeout      20m

Set Theme {
    "black":         "#090300",
    "red":           "#805000",
    "green":         "#009640",
    "yellow":        "#999900",
    "blue":          "#114C99",
    "magenta":       "#B200B2",
    "cyan":          "#009AA6",
    "white":         "#404040",
    "brightBlack":   "#090300",
    "brightRed":     "#805000",
    "brightGreen":   "#009640",
    "brightYellow":  "#999900",
    "brightBlue":    "#114C99",
    "brightMagenta": "#B200B2",
    "brightCyan":    "#009AA6",
    "brightWhite":   "#ffffff",
    "background":    "#D6E9FF",
    "foreground":    "#000000",
    "cursor":        "#6BA3E5",
    "selection":     "#A4CDFF"
}

Hide

Type "cd ../../ase"
Enter
Sleep 1s

Type 'claude {{ claude_flags }}'
Enter

Wait+Screen /⏸ claudeX/
Sleep 2s

Show

